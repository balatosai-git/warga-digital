# ─────────────────────────────────────────────────────────────────────────────
# Environment variable reference — .env.example
#
# HOW TO USE:
#   Development  → copy to .env.local          (gitignored)
#   Production   → copy to .env.production.local (gitignored)
#                  OR set directly in Vercel / hosting platform env vars
#
# NEVER commit .env.local or .env.production.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
# Use your DEV project URL/keys in .env.local
# Use your PROD project URL/keys in .env.production.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Custom Auth ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
# JWT_SECRET    — signs session JWTs (7-day expiry). Rotating invalidates sessions.
# ENCRYPTION_KEY — must be exactly 32 characters
JWT_SECRET=your-jwt-secret-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-chars-xx

# ── OTP Provider ──────────────────────────────────────────────────────────────
# "mock"      → logs OTP to server console (dev only, no WhatsApp needed)
# "clawdbot"  → sends real OTP via WhatsApp through Clawdbot webhook (prod)
OTP_PROVIDER=mock
# CLAWDBOT_WEBHOOK_URL=https://your-clawdbot-webhook-url

# ── Default Seeded IDs ────────────────────────────────────────────────────────
# Must match the UUIDs/IDs in the seed section of supabase/run-all-migrations.sql
# and supabase/seed.sql. Used for registration and Kas RT permissions.
DEFAULT_TENANT_ID=a0000000-0000-7000-8000-000000000001
DEFAULT_COMMUNITY_ID=b0000000-0000-7000-8000-000000000002
DEFAULT_ROLE_WARGA_ID=1
# Comma-separated role IDs that can submit Kas RT transactions (e.g. RT_ADMIN=4, RT_BENDAHARA=8).
# Omit to use default: 4,8
ROLE_IDS_CAN_SUBMIT_KAS_RT=4,8

# ── Storage Bucket Names ──────────────────────────────────────────────────────
# Must match bucket IDs created in the migration SQL (storage.buckets inserts).
# Change these only if you renamed the buckets in your Supabase project.
SUPABASE_BUCKET_KAS_RT=kas-rt-attachments
SUPABASE_BUCKET_MARKETPLACE=marketplace-media
SUPABASE_BUCKET_AVATARS=avatars
